{
  "_note": "単位は、SVGのviewBox（0〜100）の座標。translateは座標単位、rotateは度。回転や拡大の原点は、各グループの外枠の下中央（root）または中央（look/eyes/zz）。補間はease-in-out。",
  "canvas": { "viewBox": "-6 -6 112 112", "menubarHeightPt": 18, "maxFps": 8 },
  "states": {
    "ok": {
      "label": "制限なし",
      "targets": {
        "look": {
          "duration_s": 5,
          "easing": "ease-in-out",
          "keyframes": { "0": {"translateX": 0}, "15": {"translateX": 0}, "25": {"translateX": -8}, "45": {"translateX": -8}, "55": {"translateX": 0}, "60": {"translateX": 0}, "70": {"translateX": 8}, "90": {"translateX": 8}, "100": {"translateX": 0} }
        },
        "root": {
          "duration_s": 5,
          "easing": "ease-in-out",
          "origin": "bottom-center",
          "keyframes": { "0": {"translateX": 0, "rotate": 0}, "15": {"translateX": 0, "rotate": 0}, "25": {"translateX": -3, "rotate": -4}, "45": {"translateX": -3, "rotate": -4}, "55": {"translateX": 0, "rotate": 0}, "60": {"translateX": 0, "rotate": 0}, "70": {"translateX": 3, "rotate": 4}, "90": {"translateX": 3, "rotate": 4}, "100": {"translateX": 0, "rotate": 0} }
        },
        "eyes": {
          "duration_s": 3.4,
          "easing": "linear",
          "origin": "center",
          "keyframes": { "0": {"scaleY": 1}, "90": {"scaleY": 1}, "94": {"scaleY": 0.08}, "100": {"scaleY": 1} }
        }
      }
    },
    "limit": {
      "label": "制限中",
      "targets": {
        "root": {
          "duration_s": 3,
          "easing": "ease-in-out",
          "keyframes": { "0": {"translateY": 0}, "50": {"translateY": -9}, "100": {"translateY": 0} }
        },
        "zz": {
          "duration_s": 3,
          "easing": "ease-in-out",
          "origin": "center",
          "keyframes": { "0": {"opacity": 0.35, "translateY": 2}, "50": {"opacity": 1, "translateY": -2}, "100": {"opacity": 0.35, "translateY": 2} }
        }
      }
    },
    "fail": {
      "label": "すべて取得に失敗",
      "targets": {
        "root": {
          "duration_s": 4,
          "easing": "ease-in-out",
          "origin": "bottom-center",
          "keyframes": { "0": {"rotate": 0}, "88": {"rotate": 0}, "91": {"rotate": -5}, "94": {"rotate": 5}, "97": {"rotate": -3}, "100": {"rotate": 0} }
        }
      }
    }
  },
  "reduceMotion": "全部止める（アニメの最初の形で静止）",
  "lowPowerMode": "静止か、まばたき（ok の eyes）だけ",
  "settings": ["動く（既定）", "ときどきだけ（okのまばたきだけ）", "止める"]
}
